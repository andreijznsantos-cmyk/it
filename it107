    <!-- JAVASCRIPT -->
    <script>
        const STORAGE_KEY = "jobHuntingApplicants";

        const table = document.getElementById("applicantTable");
        const searchInput = document.getElementById("searchInput");
        const positionFilter = document.getElementById("positionFilter");
        const statusFilter = document.getElementById("statusFilter");
        const modal = document.getElementById("applicantModal");
        const form = document.getElementById("applicantForm");

        let applicants = [];

        // Load JSON data or saved browser data.
        function loadApplicants() {
            const saved = localStorage.getItem(STORAGE_KEY);

            if (saved !== null) {
                try {
                    applicants = JSON.parse(saved);
                } catch {
                    applicants = JSON.parse(
                        document.getElementById("applicantData").textContent
                    );
                }
            } else {
                applicants = JSON.parse(
                    document.getElementById("applicantData").textContent
                );
                saveApplicants();
            }

            updatePositionOptions();
            renderApplicants();
        }

        // Save changes in browser storage.
        function saveApplicants() {
            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(applicants)
            );
        }

        // Prevent user input from being interpreted as HTML.
        function escapeHTML(value) {
            return String(value ?? "").replace(/[&<>"']/g, char => ({
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            })[char]);
        }

        // Create the position filter options.
        function updatePositionOptions() {
            const selected = positionFilter.value;

            const positions = [...new Set(
                applicants.map(a => a.position)
            )].sort();

            positionFilter.innerHTML =
                '<option value="">All Positions</option>';

            positions.forEach(position => {
                const option = document.createElement("option");
                option.value = position;
                option.textContent = position;
                positionFilter.appendChild(option);
            });

            positionFilter.value = positions.includes(selected)
                ? selected
                : "";
        }

        // Display and filter applicant records.
        function renderApplicants() {
            const search = searchInput.value.toLowerCase().trim();
            const position = positionFilter.value;
            const status = statusFilter.value;

            const filtered = applicants.filter(a => {
                const text = [
                    a.name,
                    a.email,
                    a.position,
                    a.education,
                    a.skills.join(" ")
                ].join(" ").toLowerCase();

                return text.includes(search) &&
                    (!position || a.position === position) &&
                    (!status || a.status === status);
            });

            table.innerHTML = filtered.map(a => {
                const statusClass = a.status
                    .toLowerCase()
                    .replace(/\s+/g, "-");

                return `
                    <tr>
                        <td>
                            <span class="applicant-name">
                                ${escapeHTML(a.name)}
                            </span>
                            <span class="email">
                                ${escapeHTML(a.email)}
                            </span>
                        </td>
                        <td>${escapeHTML(a.position)}</td>
                        <td>${escapeHTML(a.education)}</td>
                        <td>${escapeHTML(a.skills.join(", "))}</td>
                        <td>${Number(a.experience)} Years</td>
                        <td>
                            <span class="status ${statusClass}">
                                ${escapeHTML(a.status)}
                            </span>
                        </td>
                        <td>
                            <button
                                class="delete-btn"
                                data-id="${a.id}"
                                type="button"
                            >Delete</button>
                        </td>
                    </tr>
                `;
            }).join("");

            document.getElementById("resultCount").textContent =
                `Showing ${filtered.length} of ${applicants.length} applicants`;
        }

        // Search and filter.
        searchInput.addEventListener("input", renderApplicants);
        positionFilter.addEventListener("change", renderApplicants);
        statusFilter.addEventListener("change", renderApplicants);

        // Open the form.
        document.getElementById("newApplicantBtn")
            .addEventListener("click", () => {
                form.reset();
                modal.classList.add("show");
            });

        // Close the form.
        function closeModal() {
            modal.classList.remove("show");
        }

        document.getElementById("cancelBtn")
            .addEventListener("click", closeModal);

        modal.addEventListener("click", event => {
            if (event.target === modal) {
                closeModal();
            }
        });

        // Add a new applicant.
        form.addEventListener("submit", event => {
            event.preventDefault();

            const newApplicant = {
                id: Date.now(),
                name: document.getElementById("name").value.trim(),
                email: document.getElementById("email").value.trim(),
                position: document.getElementById("position").value.trim(),
                education: document.getElementById("education").value.trim(),
                skills: document.getElementById("skills").value
                    .split(",")
                    .map(skill => skill.trim())
                    .filter(Boolean),
                experience: Number(
                    document.getElementById("experience").value
                ),
                status: document.getElementById("status").value
            };

            applicants.push(newApplicant);

            saveApplicants();
            updatePositionOptions();
            renderApplicants();
            closeModal();
        });

        // Delete an applicant.
        table.addEventListener("click", event => {
            const button = event.target.closest("[data-id]");

            if (!button) return;

            const id = Number(button.dataset.id);
            const applicant = applicants.find(a => a.id === id);

            if (applicant && confirm(
                `Delete ${applicant.name} from the applicant list?`
            )) {
                applicants = applicants.filter(a => a.id !== id);
                saveApplicants();
                updatePositionOptions();
                renderApplicants();
            }
        });

        // Start the application.
        loadApplicants();
    </script>
</body>
</html>
