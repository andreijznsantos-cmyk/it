
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Applicant Management - Job Hunting</title>

    <!-- CSS -->
    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background: #f5f7fb;
            color: #1e293b;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            gap: 15px;
        }

        h1 {
            margin-bottom: 8px;
            color: #172b4d;
            font-size: 26px;
        }

        header p {
            color: #7b8798;
            font-size: 13px;
        }

        button {
            padding: 11px 16px;
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 7px;
            cursor: pointer;
            font-weight: bold;
        }

        button:hover {
            background: #1d4ed8;
        }

        .filters {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        input, select {
            padding: 11px;
            border: 1px solid #dce2eb;
            border-radius: 7px;
            background: white;
            font-size: 13px;
        }

        .filters input {
            flex: 1;
            min-width: 120px;
        }

        .filters select {
            min-width: 150px;
        }

        .card {
            padding: 22px;
            background: white;
            border: 1px solid #e5eaf1;
            border-radius: 12px;
            box-shadow: 0 3px 12px #172b4d08;
            overflow-x: auto;
        }

        .card h2 {
            margin-top: 0;
            font-size: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            white-space: nowrap;
        }

        th {
            padding: 14px 12px;
            background: #f8fafc;
            color: #718096;
            font-size: 10px;
        }

        td {
            padding: 16px 12px;
            border-bottom: 1px solid #edf0f5;
            font-size: 12px;
        }

        tbody tr:hover {
            background: #f8fbff;
        }

        .applicant-name {
            display: block;
            font-weight: bold;
            color: #243247;
        }

        .email {
            display: block;
            margin-top: 5px;
            color: #8994a5;
            font-size: 11px;
        }

        .status {
            display: inline-block;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
        }

        .in-review {
            color: #2563eb;
            background: #eaf2ff;
        }

        .shortlisted {
            color: #15803d;
            background: #dcfce7;
        }

        .rejected {
            color: #c24141;
            background: #fee2e2;
        }

        .interview {
            color: #a16207;
            background: #fef3c7;
        }

        .hired {
            color: #047857;
            background: #d1fae5;
        }

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 10;
            padding: 20px;
            background: #172b4d80;
            align-items: center;
            justify-content: center;
            overflow-y: auto;
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            width: 100%;
            max-width: 550px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 25px;
            background: white;
            border-radius: 12px;
        }

        .modal-content h2 {
            margin-top: 0;
        }

        .modal-content p {
            color: #718096;
            font-size: 13px;
        }

        #applicantForm {
            display: grid;
            gap: 10px;
        }

        #applicantForm label {
            font-size: 12px;
            font-weight: bold;
        }

        #applicantForm input,
        #applicantForm select {
            width: 100%;
            margin-bottom: 8px;
        }

        .form-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 12px;
        }

        .cancel-btn {
            background: #e2e8f0;
            color: #334155;
        }

        .delete-btn {
            padding: 6px 9px;
            background: #fee2e2;
            color: #b91c1c;
        }

        .delete-btn:hover {
            background: #fecaca;
        }

        #resultCount {
            color: #718096;
            font-size: 12px;
            margin-top: 20px;
        }

        @media (max-width: 700px) {
            body {
                padding: 15px;
            }

            header {
                align-items: flex-start;
                flex-direction: column;
            }

            .filters {
                flex-direction: column;
            }

            .filters input,
            .filters select {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="container">

        <!-- Header -->
        <header>
            <div>
                <h1>Applicant Management</h1>
                <p>Review and manage candidate applications</p>
            </div>
            <button id="newApplicantBtn">+ New Applicant</button>
        </header>

        <!-- Search and Filters -->
        <section class="filters">
            <input
                type="text"
                id="searchInput"
                placeholder="Search applicants..."
            >

            <select id="positionFilter">
                <option value="">All Positions</option>
            </select>

            <select id="statusFilter">
                <option value="">All Statuses</option>
                <option>In Review</option>
                <option>Shortlisted</option>
                <option>Rejected</option>
                <option>Interview</option>
                <option>Hired</option>
            </select>
        </section>

        <!-- Applicant Table -->
        <section class="card">
            <h2>All Applicants</h2>

            <table>
                <thead>
                    <tr>
                        <th>APPLICANT</th>
                        <th>APPLIED POSITION</th>
                        <th>EDUCATION</th>
                        <th>SKILLS</th>
                        <th>EXPERIENCE</th>
                        <th>STATUS</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody id="applicantTable"></tbody>
            </table>

            <p id="resultCount"></p>
        </section>
    </div>

    <!-- New Applicant Form -->
    <div id="applicantModal" class="modal">
        <div class="modal-content">
            <h2>New Applicant</h2>
            <p>Enter the candidate's details below.</p>

            <form id="applicantForm">
                <label for="name">Full Name *</label>
                <input type="text" id="name" required>

                <label for="email">Email Address</label>
                <input type="email" id="email">

                <label for="position">Applied Position *</label>
                <input type="text" id="position" required>

                <label for="education">Educational Background</label>
                <input type="text" id="education">

                <label for="skills">Skills</label>
                <input
                    type="text"
                    id="skills"
                    placeholder="Figma, UX, UI"
                >

                <label for="experience">Years of Experience</label>
                <input
                    type="number"
                    id="experience"
                    min="0"
                    value="0"
                    required
                >

                <label for="status">Application Status</label>
                <select id="status">
                    <option>In Review</option>
                    <option>Shortlisted</option>
                    <option>Rejected</option>
                    <option>Interview</option>
                    <option>Hired</option>
                </select>

                <div class="form-buttons">
                    <button
                        type="button"
                        id="cancelBtn"
                        class="cancel-btn"
                    >Cancel</button>

                    <button type="submit">Save Applicant</button>
                </div>
            </form>
        </div>
    </div>

    <!-- JSON DATA -->
    <script id="applicantData" type="application/json">
